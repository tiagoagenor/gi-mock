// GI-Mock — schema do banco (MySQL via Prisma)
// Fonte: documento de arquitetura. Ajustes: bcrypt para senha.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────
// AUTENTICAÇÃO
// ─────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  apiKeys     ApiKey[]
  folders     Folder[]
  mocks       Mock[]
  libs        Lib[]
  variables   Variable[]
  middlewares Middleware[]

  @@index([isActive])
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?  @db.VarChar(512)
  ip         String?  @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────
// API KEYS
// ─────────────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    @unique @db.VarChar(24)
  keyHash    String    @db.VarChar(128)
  scopes     Json
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ─────────────────────────────────────────────────────────
// PASTAS (árvore self-referencing)
// ─────────────────────────────────────────────────────────
model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  prefix    String   @default("") @db.VarChar(512)
  order     Int      @default(0)
  path      String   @default("/") @db.VarChar(768)
  depth     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Folder?            @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]           @relation("FolderTree")
  mocks       Mock[]
  middlewares FolderMiddleware[]

  @@unique([parentId, name])
  @@index([userId])
  @@index([parentId, order])
}

// ─────────────────────────────────────────────────────────
// MOCK / ENDPOINT
// ─────────────────────────────────────────────────────────
model Mock {
  id               String       @id @default(cuid())
  userId           String
  folderId         String?
  hash             String       @unique @db.VarChar(16)
  method           HttpMethod
  path             String       @db.VarChar(512)
  name             String?
  description      String?      @db.Text
  responseMode     ResponseMode @default(RULES)
  forcedResponseId String?      @unique
  isEnabled        Boolean      @default(true)
  order            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  responses      MockResponse[] @relation("MockResponses")
  forcedResponse MockResponse? @relation("ForcedResponse", fields: [forcedResponseId], references: [id], onDelete: SetNull)
  logs           RequestLog[]
  middlewares    MockMiddleware[]

  @@unique([folderId, method, path], name: "uq_folder_method_path")
  @@index([folderId, order])
  @@index([userId])
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ResponseMode {
  RULES
  SEQUENTIAL
  RANDOM
}

// ─────────────────────────────────────────────────────────
// MOCK RESPONSE
// ─────────────────────────────────────────────────────────
model MockResponse {
  id            String           @id @default(cuid())
  mockId        String
  label         String?
  statusCode    Int              @default(200)
  headers       Json
  bodyMode      ResponseBodyMode @default(STATIC)
  body          String?          @db.LongText
  code          String?          @db.LongText
  latencyMs     Int              @default(0)
  rulesOperator RuleOperatorMode @default(OR)
  isDefault     Boolean          @default(false)
  testRequest   String?          @db.LongText
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  mock         Mock         @relation("MockResponses", fields: [mockId], references: [id], onDelete: Cascade)
  rules        Rule[]
  forcedByMock Mock?        @relation("ForcedResponse")
  logs         RequestLog[]

  @@index([mockId, order])
}

enum ResponseBodyMode {
  STATIC
  SCRIPT
}

enum RuleOperatorMode {
  AND
  OR
}

// ─────────────────────────────────────────────────────────
// RULE
// ─────────────────────────────────────────────────────────
model Rule {
  id            String     @id @default(cuid())
  responseId    String
  target        RuleTarget
  path          String?    @db.VarChar(512)
  operator      RuleOp
  value         String?    @db.Text
  caseSensitive Boolean    @default(true)
  invert        Boolean    @default(false)
  order         Int        @default(0)

  response MockResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId, order])
}

enum RuleTarget {
  QUERY
  HEADER
  BODY
  PATH_PARAM
  COOKIE
  METHOD
  REQUEST_NUMBER
}

enum RuleOp {
  EQUALS
  CONTAINS
  REGEX
  EXISTS
  NULL_OR_ABSENT
  GT
  LT
}

// ─────────────────────────────────────────────────────────
// LIBS injetáveis no sandbox
// ─────────────────────────────────────────────────────────
model Lib {
  id          String   @id @default(cuid())
  userId      String
  name        String   @unique
  kind        LibKind
  packageName    String?
  version        String?
  sourceCode     String?   @db.LongText
  isEnabled      Boolean   @default(true)
  installStatus  String?   @db.VarChar(16) // "success" | "error" | null (utilitária)
  installCommand String?   @db.Text
  installLog     String?   @db.LongText
  installedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum LibKind {
  NPM_WHITELISTED
  UTILITY
}

// ─────────────────────────────────────────────────────────
// LOGS
// ─────────────────────────────────────────────────────────
model RequestLog {
  id              String   @id @default(cuid())
  mockId          String?
  responseId      String?
  method          String   @db.VarChar(10)
  path            String   @db.VarChar(1024)
  statusCode      Int
  ip              String?  @db.VarChar(64)
  requestHeaders  Json?
  requestBody     String?  @db.LongText
  requestQuery    Json?
  responseHeaders Json?
  responseBody    String?  @db.LongText
  responseBytes   Int?
  durationMs      Int
  matchedByRules  Boolean  @default(false)
  scriptError     String?  @db.Text
  createdAt       DateTime @default(now())

  mock     Mock?         @relation(fields: [mockId], references: [id], onDelete: SetNull)
  response MockResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([mockId, createdAt])
  @@index([statusCode])
  @@index([method])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// VARIÁVEIS GLOBAIS (ex.: credenciais/segredos p/ JWT)
// ─────────────────────────────────────────────────────────
model Variable {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  value     String   @db.Text
  secret    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// MIDDLEWARES (código .mjs vinculável a mocks)
// ─────────────────────────────────────────────────────────
model Middleware {
  id          String   @id @default(cuid())
  userId      String
  name        String   @unique
  description String?  @db.Text
  code        String   @db.LongText
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mocks   MockMiddleware[]
  folders FolderMiddleware[]

  @@index([userId])
}

// Vínculo (ordenado) entre um mock e os middlewares que rodam antes dele.
model MockMiddleware {
  id           String @id @default(cuid())
  mockId       String
  middlewareId String
  order        Int    @default(0)

  mock       Mock       @relation(fields: [mockId], references: [id], onDelete: Cascade)
  middleware Middleware @relation(fields: [middlewareId], references: [id], onDelete: Cascade)

  @@unique([mockId, middlewareId])
  @@index([mockId, order])
}

// Vínculo (ordenado) entre uma pasta e os middlewares que rodam para todos os
// mocks dentro dela (e das subpastas).
model FolderMiddleware {
  id           String @id @default(cuid())
  folderId     String
  middlewareId String
  order        Int    @default(0)

  folder     Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  middleware Middleware @relation(fields: [middlewareId], references: [id], onDelete: Cascade)

  @@unique([folderId, middlewareId])
  @@index([folderId, order])
}
