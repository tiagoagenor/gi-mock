# MySQL (matches docker-compose.yml — host port 3310 to avoid clashing with a local MySQL)
DATABASE_URL="mysql://gimock:gimock@127.0.0.1:3310/gimock"

# Secret used to sign session cookies and hash API keys. CHANGE THIS in production.
AUTH_SECRET="dev-only-change-me-please-use-a-long-random-string-0123456789"

# First admin user, created by the seed script.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="admin123"

# Sandbox limits for user mock code
SANDBOX_TIMEOUT_MS="1000"
SANDBOX_MEMORY_MB="64"
